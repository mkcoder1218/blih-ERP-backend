NODE_ENV=production
PORT=4000
APP_PORT=4000
API_VERSION=v1

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# PostgreSQL / Sequelize
DB_HOST=db
DB_PORT=5432
DB_NAME=blih_erp
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_database_password
DB_DIALECT=postgres
DB_SYNC=false

# App integrations
CORS_ORIGINS=https://your-frontend.example.com
APP_URL=https://your-frontend.example.com
JOB_WORKER_ENABLED=false
JOB_TIMEZONE=UTC

# Optional first Platform Super Admin seed
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Blih ERP
SMTP_FROM_EMAIL=no-reply@example.com
OFFER_LETTER_PDF_STORAGE_PATH=/app/uploads/offer_letters
# Employee policy service
POLICIES_API_BASE_URL=https://blih-knowledge-base-backend.onrender.com/api/v1
GUEST_API_KEY=gst_8F3kP9xL2mQ7vN4R
