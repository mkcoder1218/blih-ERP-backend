NODE_ENV=development
PORT=4000

# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# PostgreSQL / Sequelize
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blih
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
PG_DUMP_PATH=pg_dump

# Dev-only auto sync (DANGEROUS in production)
DB_SYNC=true

# Seed first Platform Super Admin (optional)
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL="admin@platform.local"
PLATFORM_ADMIN_PASSWORD="change_me"

# Email Configuration
# 32+ character secret used to encrypt business SMTP credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_secret_32_chars_min
# Keep true in production. For local development behind TLS-inspecting antivirus/proxy,
# prefer NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem. As a temporary local-only
# fallback, set SMTP_TLS_REJECT_UNAUTHORIZED=false.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Your Company HR"
SMTP_FROM_EMAIL=hr@yourcompany.com
APP_URL=http://localhost:5173
OFFER_LETTER_PDF_STORAGE_PATH=./uploads/offer_letters

# Google Calendar OAuth
# Add this exact redirect URI to the Google Cloud OAuth client:
# http://localhost:4000/api/v1/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/calendar/google/callback

# Policies service used for unauthenticated onboarding policy snapshots
POLICIES_API_BASE_URL=
GUEST_API_KEY=
